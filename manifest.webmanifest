{
  "id": "/",
  "name": "Task2Day — Task, Study, Steady growth",
  "short_name": "Task2Day",
  "description": "Task, Study, Steady growth — a daily planner with backlog pressure and active-recall revision.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#fdf2e4",
  "theme_color": "#fdf2e4",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's tasks",
      "short_name": "Today",
      "description": "Open straight to today's sessions and tasks.",
      "url": "./?screen=today",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Plan",
      "short_name": "Plan",
      "description": "Open the Plan screen to add or break down a target.",
      "url": "./?screen=plan",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}